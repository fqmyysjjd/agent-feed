{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Development Session State",
  "type": "object",
  "required": [
    "schema_version",
    "session_id",
    "conversation_identity",
    "continuity",
    "created_at",
    "updated_at",
    "repository",
    "purpose",
    "topics"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "integer", "const": 2 },
    "session_id": { "type": "string", "minLength": 1 },
    "conversation_identity": {
      "type": "object",
      "required": ["source", "external_thread_id", "session_alias", "resume_hint"],
      "additionalProperties": false,
      "properties": {
        "source": { "type": "string" },
        "external_thread_id": { "type": "string" },
        "session_alias": { "type": "string", "minLength": 1 },
        "resume_hint": { "type": "string", "minLength": 1 }
      }
    },
    "continuity": {
      "type": "object",
      "required": [
        "current_user_goal",
        "active_task_boundary",
        "active_topic_ids",
        "last_handoff_summary",
        "next_required_action"
      ],
      "additionalProperties": false,
      "properties": {
        "current_user_goal": { "type": "string", "minLength": 1 },
        "active_task_boundary": { "type": "string" },
        "active_topic_ids": { "type": "array", "items": { "type": "string" } },
        "last_handoff_summary": { "type": "string" },
        "next_required_action": { "type": "string" }
      }
    },
    "created_at": { "type": "string" },
    "updated_at": { "type": "string" },
    "repository": { "type": "string" },
    "purpose": { "type": "string" },
    "topics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "topic_id",
          "title",
          "status",
          "context",
          "conclusion",
          "next_action",
          "blocking_questions",
          "related_files",
          "updated_at"
        ],
        "additionalProperties": false,
        "properties": {
          "topic_id": { "type": "string" },
          "title": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "enum": ["active", "blocked", "ready_for_action"] },
          "context": { "type": "string" },
          "conclusion": { "type": "string" },
          "next_action": { "type": "string" },
          "blocking_questions": { "type": "array", "items": { "type": "string" } },
          "related_files": { "type": "array", "items": { "type": "string" } },
          "updated_at": { "type": "string" }
        }
      }
    }
  }
}
